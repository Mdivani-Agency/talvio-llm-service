{
  "name": "llm-service",
  "version": "1.0.0",
  "private": true,
  "description": "Talvio LLM orchestration service (/llm/v1)",
  "workspaces": [
    "packages/*"
  ],
  "main": "serverless.ts",
  "scripts": {
    "format": "prettier . --write",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "start": "sls offline start --stage local",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:contracts": "yarn workspace @talvio/llm-contracts test",
    "check": "yarn lint && yarn typecheck && yarn test && yarn test:contracts"
  },
  "author": "Giorgi Mdivani",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@talvio/llm-contracts": "workspace:*",
    "jose": "5.10.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@serverless/typescript": "4.30.0",
    "@types/aws-lambda": "8.10.163",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@typescript-eslint/eslint-plugin": "8.46.0",
    "@typescript-eslint/parser": "8.46.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-unused-imports": "4.1.4",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "serverless": "4.42.0",
    "serverless-domain-manager": "6.2.1",
    "serverless-offline": "14.8.2",
    "ts-jest": "29.4.12",
    "typescript": "5.8.3"
  },
  "packageManager": "yarn@4.3.1"
}
