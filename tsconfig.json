{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "jest"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["./src/lib/*"],
      "@talvio/llm-contracts": ["./packages/contracts/src"],
      "@talvio/llm-contracts/fixtures": ["./packages/contracts/src/fixtures"]
    }
  },
  "include": ["src/**/*.ts", "serverless.ts"],
  "exclude": ["node_modules", "packages"]
}
