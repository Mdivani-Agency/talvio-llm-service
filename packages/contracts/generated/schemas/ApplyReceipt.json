{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "receiptId": {
      "$ref": "#/$defs/__schema0"
    },
    "proposalId": {
      "$ref": "#/$defs/__schema0"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "profile"
            },
            "profileId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "profileId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resume"
            },
            "resumeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "resumeId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "resultingRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "appliedChangeIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "acceptedOmissionIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "receiptId",
    "proposalId",
    "target",
    "resultingRevision",
    "appliedChangeIds",
    "acceptedOmissionIds",
    "replayed"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
    }
  }
}
