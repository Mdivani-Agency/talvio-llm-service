  "$defs": {
    "__schema0": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "__schema1": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "__schema2": {
      "default": "en-US",
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|\\d{3}))?$"
    },
    "__schema3": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "coverage": {
          "type": "string",
          "enum": [
            "text",
            "empty",
            "uncertain"
          ]
        }
      },
      "required": [
        "page",
        "start",
        "end",
        "coverage"
      ],
      "additionalProperties": false
    },
    "__schema4": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema5": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema4"
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema6": {
      "type": "string",
      "enum": [
        "person",
        "contacts",
        "location",
        "experience",
        "education",
        "projects",
        "recommendations",
        "skills",
        "tools",
        "links",
        "languages"
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "sections": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          }
        },
        "targetRole": {
          "anyOf": [
            {
              "$ref": "#/$defs/__schema9"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sections",
        "targetRole"
      ],
      "additionalProperties": false
