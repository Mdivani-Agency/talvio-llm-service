{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "jobId": {
      "$ref": "#/$defs/__schema0"
    },
    "proposalId": {
      "$ref": "#/$defs/__schema0"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "profile"
            },
            "profileId": {
              "$ref": "#/$defs/__schema0"
            },
            "baseRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "kind",
            "profileId",
            "baseRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resume_draft"
            },
            "resumeId": {
              "$ref": "#/$defs/__schema0"
            },
            "baseRevision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "kind",
            "resumeId",
            "baseRevision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resume_draft_family"
            },
            "generatedResumeId": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "kind",
            "generatedResumeId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "new_resume"
            },
            "resumeType": {
              "$ref": "#/$defs/__schema1"
            },
            "derivedFrom": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "profile"
                    },
                    "id": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema2"
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "revision"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "resume"
                    },
                    "id": {
                      "$ref": "#/$defs/__schema0"
                    },
                    "revision": {
                      "$ref": "#/$defs/__schema2"
                    },
                    "resumeType": {
                      "$ref": "#/$defs/__schema1"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "draft",
                        "generated"
                      ]
                    },
                    "sourceResumeId": {
                      "anyOf": [
                        {
                          "$ref": "#/$defs/__schema0"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "id",
                    "revision",
                    "resumeType",
                    "state",
                    "sourceResumeId"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "kind",
            "resumeType",
            "derivedFrom"
          ],
          "additionalProperties": false
        }
      ]
    },
    "clientDraftId": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema0"
        },
        {
          "type": "null"
        }
      ]
    },
    "selectedChangeIds": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "acceptedOmissionIds": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "confirmedClaimIds": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema3"
      }
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "proposalId",
    "idempotencyKey",
    "target",
    "clientDraftId",
    "selectedChangeIds",
    "acceptedOmissionIds",
    "confirmedClaimIds"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "general",
        "job_specific"
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "__schema3": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
    }
  }
}
