{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "documentId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_upload",
            "validating",
            "ready",
            "rejected",
            "expired",
            "deleted"
          ]
        },
        "contentType": {
          "type": "string",
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pageCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "ocrPages": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "rejectionCode": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "unsupported_media_type",
                "payload_too_large",
                "unusable_document",
                "checksum_mismatch"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "createdAt": {
          "$ref": "#/$defs/__schema2"
        },
        "expiresAt": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "documentId",
        "status",
        "contentType",
        "sizeBytes",
        "pageCount",
        "ocrPages",
        "rejectionCode",
        "warnings",
        "createdAt",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "upload": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "PUT"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "expiresAt": {
          "$ref": "#/$defs/__schema2"
        }
      },
      "required": [
        "method",
        "url",
        "headers",
        "expiresAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "document",
    "upload"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "entityId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "message",
        "entityId",
        "page"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  }
}
