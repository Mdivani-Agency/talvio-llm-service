{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_request",
            "idempotency_key_required",
            "unauthorized",
            "not_found",
            "stale_context",
            "idempotency_conflict",
            "invalid_retry",
            "payload_too_large",
            "unsupported_media_type",
            "unusable_document",
            "ocr_page_limit",
            "budget_exceeded_preflight",
            "unsupported_language",
            "quota_exceeded",
            "dependency_unavailable",
            "internal_error"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "correlationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "issues": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "correlationId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "path",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
