{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "baseContextRevisionId": {
      "$ref": "#/$defs/__schema0"
    },
    "questionSetId": {
      "$ref": "#/$defs/__schema0"
    },
    "answers": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "schemaVersion",
    "baseContextRevisionId",
    "questionSetId",
    "answers"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "__schema1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "questionId": {
              "$ref": "#/$defs/__schema2"
            },
            "status": {
              "type": "string",
              "const": "answered"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "questionId",
            "status",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "questionId": {
              "$ref": "#/$defs/__schema2"
            },
            "status": {
              "type": "string",
              "const": "skipped"
            }
          },
          "required": [
            "questionId",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]*$"
    }
  }
}
