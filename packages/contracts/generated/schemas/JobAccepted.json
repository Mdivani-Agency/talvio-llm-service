{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_external",
        "retry_wait",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "statusUrl": {
      "type": "string",
      "pattern": "^\\/llm\\/v1\\/jobs\\/[0-9a-f-]{36}$"
    },
    "pollAfterMs": {
      "type": "integer",
      "minimum": 500,
      "maximum": 30000
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "jobId",
    "status",
    "statusUrl",
    "pollAfterMs",
    "replayed"
  ],
  "additionalProperties": false
}
